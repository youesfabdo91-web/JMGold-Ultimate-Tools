{
  "name": "jmgold-ultimate-tools",
  "version": "1.2.0",
  "description": "Premium Gaming Utility Dashboard - JMGOLD ULTIMATE TOOLS",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "JM Development",
  "license": "MIT",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^4.9.0",
    "electron": "^22.0.0",
    "electron-builder": "^23.0.0",
    "concurrently": "^7.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.jmgold.ultimate-tools",
    "productName": "JMGOLD ULTIMATE TOOLS",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
