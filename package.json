{
  "name": "jmgold-ultimate-tools",
  "version": "1.2.0",
  "description": "Premium Gaming Utility Dashboard - JMGOLD ULTIMATE TOOLS",
  "author": "JM Development",
  "license": "MIT",
  "main": "public/main-process.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "make-exe": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "electron-squirrel-startup": "^1.1.1",
    "robotjs": "^0.6.0",
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^4.9.0",
    "electron": "^22.0.0",
    "electron-builder": "^23.0.0",
    "concurrently": "^7.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.jmgold.ultimate-tools",
    "productName": "JMGOLD ULTIMATE TOOLS",
    "files": [
      "build/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ],
      "sign": "./customSign.js"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JMGOLD ULTIMATE TOOLS"
    },
    "portable": {
      "artifactName": "JMGOLD-ULTIMATE-TOOLS-${version}.${ext}"
    }
  },
  "eslintConfig": {
    "extends": ["react-app"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
